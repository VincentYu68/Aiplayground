{
  "name": "brickify",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turn a photo of an object into a stable, buildable LEGO model with a 3D interactive step-by-step assembly manual.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && VITE_NO_WORKER=1 vite build --outDir dist-single && node scripts-inline.mjs dist-single dist-single/brickify.html",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/sync-ort.mjs",
    "prebuild": "node scripts/sync-ort.mjs",
    "pretest": "node scripts/sync-ort.mjs",
    "bench": "vite-node bench/run.ts",
    "bench:browser": "node bench/browser.mjs",
    "bench:3d": "vite-node bench/run3d.ts",
    "bench:quality": "vite-node bench/quality.ts",
    "bench:photos": "vite-node bench/makephotos.ts",
    "e2e": "node bench/e2e.mjs",
    "e2e:multiview": "node bench/e2e-multiview.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
